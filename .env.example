# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own values.
# Never commit a real .env or any credentials.
# ---------------------------------------------------------------------------

# --- Runtime ---
ENVIRONMENT=development
PORT=3000

# --- Database ---
# For a local run against docker-compose, Postgres is exposed on host port 5435.
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/mailing_db?schema=public"

# --- Auth ---
# Generate TWO DIFFERENT random values, each at least 32 characters.
JWT_SECRET=
SECRET_KEY=
CORS_ORIGINS=http://localhost:3001

# --- Telegram bots ---
MAIN_BOT="000000000:replace-with-your-main-bot-token"
BOT_TOKEN="000000000:replace-with-your-bot-token"
ADMIN_CHAT_ID="-1000000000000"
BOT_APPLICATIONS_TOPIC_ID=9
MAILING_APPLICATIONS_TOPIC_ID=12
MAILING_NOTIFY_TOPIC_ID=14
MAILINGS_CHAT_ID="-1000000000000"
TELEGRAM_WEBHOOK_URL=https://example.com

# --- Telegram userbot service (telethon) ---
# api_id / api_hash are issued by https://my.telegram.org
TELEGRAM_API_ID=0
TELEGRAM_API_HASH="replace-with-your-api-hash"
TELETHON_SESSION_NAME=userbot
TELETHON_CLIENT_URL=http://telethon-api:8000

# --- Internal services ---
GATEWAY_URL=https://example.com
USERBOT_URL="https://example.com/userBotApi"
GO_MAILING_WORKER_URL=http://go-mailing-worker:8080
# Base URL the mailing worker uses to fetch post media from
MAIN_SERVICE_URL=http://nest-app:3000/api/v1
MOTIV_TRAFFIC_BACKEND_URL=
MALLING_BACKEND_URL=
GREETINGS_BACKEND_URL=

# --- Billing / commissions ---
SERVICE_COMMISSION_FIXED=10
SERVICE_COMMISSION_PER_USER=0.00005
SERVICE_DEFAULT_SUBSCRIBER_PRICE=0.0005
SERVICE_CHANNEL_DEFAULT_SUBSCRIBER_PRICE=0.0002

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
