// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())
  telegramId String @unique
  username String? @unique
  createdAt DateTime @default(now())
  refreshToken String?
  passwordHash String

  BotSeller BotSeller[]

  Mailing Mailing[]
}

enum BotSellerStatus {
  PENDING
  APPROVED
  REJECTED
  WAITING
}

enum MailingStatus {
  PENDING
  APPROVED
  REJECTED
  WAITING
  COMPLETED
}

enum BotCategories {
  GAMBLING      // Гэмблинг
  OTHER         // Другое 
  DATING        // Знакомства
  GAMES         // Игры
  CRYPTO        // Крипто
  FUN           // Развлечения
  TECH          // Технологии/нейросети
  UTILITY       // Утилиты/Продуктивность
}

enum QueueStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PAUSED
  CANCELLED
}

model BotSeller {
  id Int @id @default(autoincrement())
  userId Int
  botToken String?
  usersData Json
  description String?
  createdAt DateTime @default(now())
  fixedPrice Float?                        // фикс цена за всю рассылку
  subscriberPrice Float?                   // за 1 подписаного подпищика на канал рассылки
  link String
  isActive Boolean @default(false)
  acceptStatus BotSellerStatus @default(PENDING)
  category BotCategories @default(OTHER)
  isChannel Boolean @default(false)
  channelId String?                       // ID канала, если isChannel = true
  statisticsFilePath String?               // путь к файлу статистики бота
  title String?                     // название бота
  avatarUrl String?                // URL аватара бота
  isIncludedInReferrals Boolean @default(true) // Включен ли бот в реферальную программу


  // Bot statistics
  totalBotAudience Int? @default(0) // общая аудитория бота
  botLiveAudience Int? @default(0)         //  живые люди
  botMonthlyActiveUsers Int? @default(0)   // мау

  lastMailingPeopleIncome Int? @default(0) // Какое кол-во пришло с прошлой рассылки
  lastMailingDate DateTime? // Дата последней рассылки
  lastMailingMoneyIncome Int? @default(0) // Сколько пришло денег с последней рассылки

  // channel statistics 
  channelAudience Int? @default(0) // общая ааудитория
  channelDaylyActiveUsers Int? @default(0) // суточный охват
  channelDailyPeopleIncome Int? @default(0) // прирост в сутки

  user User @relation(fields: [userId], references: [id])

  mailingReservations MailingReservation[]

  MailingTargetBots MailingTargetBots[]

  LockedDays LockedDays[]
}

model MailingReservation {
  id Int @id @default(autoincrement())
  mailingId Int
  botSellerId Int
  date DateTime
  heldAmount Float @default(0) // Сумма, которая удерживается для рассылки
  paidAmount Float @default(0) // Сумма, которая уже оплачена
  trackingLink String?
  isProcessed Boolean @default(false) // Флаг, что рассылка обработана
  processedAt DateTime? // Дата, когда рассылка была обработана
  adminApprovalStatus String @default("PENDING") // Статус одобрения админом
  forwardedMessageId String? // ID сообщения, которое было переслано в канал
  viewCount Int @default(0) // Количество просмотров рассылки



  mailing Mailing @relation(fields: [mailingId], references: [id])
  botSeller BotSeller @relation(fields: [botSellerId], references: [id])

  ReservationQueue ReservationQueue[]
}

model ReservationQueue {
  id Int @id @default(autoincrement())
  mailingReservationId Int
  queueName String // Имя очереди (например, "mailingQueue")
  totalUsers Int @default(0) // Общее количество пользователей в очереди
  sentCount Int @default(0) // Количество отправленных сообщений
  failedCount Int @default(0) // Количество неудачных отправок
  status String @default("PENDING") // Статус очереди (PENDING, PROCESSING, COMPLETED, FAILED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  

  mailingReservation MailingReservation @relation(fields: [mailingReservationId], references: [id], onDelete: Cascade)
}

model Mailing {
  id Int @id @default(autoincrement())
  userId Int
  botToken String?

  channelId String? // ID канала, если isChannel = true

  link String // Ссылка на бота
  

  status MailingStatus @default(PENDING)
  isActive Boolean @default(false)
  

  // post
  postContent String
  postButtons Json
  postMedia String?
  postMediaType String?

  user User @relation(fields: [userId], references: [id])
  
  mailingReservations MailingReservation[]

  MailingTargetBots MailingTargetBots[]
}

model MailingTargetBots {
  id Int @id @default(autoincrement())
  botSellerId Int
  mailingId Int
  paymentType String @default("fixed")
    // post
  postContent String?
  postButtons Json?
  postMedia String?
  postMediaType String?
  postLink String?


  botSeller BotSeller @relation(fields: [botSellerId], references: [id])
  mailing Mailing @relation(fields: [mailingId], references: [id])
}

model LockedDays {
  id Int @id @default(autoincrement())
  date DateTime
  botSellerId Int

  botSeller BotSeller @relation(fields: [botSellerId], references: [id])
}
